# Streamlit Community Cloud Secrets
# Copy this content into your app's Settings > Secrets panel
# See README.md (setup guide + "Cross-Poster Setup") for instructions.
# NOTE: this is TOML, not .env — values need quotes, and any bare KEY = "value"
# must appear ABOVE the first [section] header or it gets nested into it.

# --- Gemini AI (required) --------------------------------------------------
GEMINI_API_KEY = "your-gemini-api-key-here"

# --- Cross-Poster: LinkedIn (required to actually post; skip for dry-run) --
LINKEDIN_ACCESS_TOKEN = ""
LINKEDIN_PERSON_URN = ""

# --- Cross-Poster: Threads / Meta (required to actually post) --------------
META_LONG_LIVED_TOKEN = ""
THREADS_USER_ID = ""

# --- Nerd Out Corpus write (optional; skip to leave the corpus write a no-op)
# Fine-grained GitHub PAT scoped to just the nerdout-corpus repo, with
# "Contents: Read and write" permission.
CORPUS_GITHUB_TOKEN = ""
# Defaults to paxdraconia/nerdout-corpus and branch "master" if left blank.
CORPUS_GITHUB_REPO = ""
CORPUS_GITHUB_BRANCH = ""

# --- Phase 2 only (scheduling + email notifications) -----------------------
LINKEDIN_CLIENT_ID = ""
LINKEDIN_CLIENT_SECRET = ""
META_APP_ID = ""
META_APP_SECRET = ""
NOTIFY_EMAIL = ""
SENDGRID_API_KEY = ""

# --- Google service account credentials (required) -------------------------
# Paste the ENTIRE contents of your service account JSON key below
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "your-private-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
client_email = "your-sa@your-project.iam.gserviceaccount.com"
client_id = "123456789"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-sa%40your-project.iam.gserviceaccount.com"
