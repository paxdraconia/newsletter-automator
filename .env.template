# Copy this file to .env and fill in your values
# See README.md for setup instructions

# --- Google Sheets (required) ----------------------------------------------
# Path to your Google service account JSON key file (local development only)
GOOGLE_SERVICE_ACCOUNT_FILE=path/to/your-service-account.json

# --- Gemini AI (required for clustering, drafting, cross-poster previews) --
# API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- Cross-Poster: LinkedIn (required to actually post; skip for dry-run) --
# After completing the LinkedIn OAuth setup (see CROSS_POST_SETUP.md):
#   - LINKEDIN_ACCESS_TOKEN: 60-day bearer token from the OAuth flow
#   - LINKEDIN_PERSON_URN: your URN, e.g. "urn:li:person:abc123"
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# --- Cross-Poster: Threads / Meta (required to actually post) --------------
# After completing the Threads OAuth setup (see CROSS_POST_SETUP.md):
#   - META_LONG_LIVED_TOKEN: 60-day token (refreshable indefinitely)
#   - THREADS_USER_ID: your Threads user ID (numeric string)
META_LONG_LIVED_TOKEN=
THREADS_USER_ID=

# --- Nerd Out Corpus write (optional; skip to leave the corpus write a no-op)
# Fine-grained GitHub PAT scoped to just the nerdout-corpus repo, with
# "Contents: Read and write" permission. Used to commit each published issue
# to that repo via the GitHub API (Streamlit Cloud has no local filesystem
# access to a corpus repo checkout).
CORPUS_GITHUB_TOKEN=
# Defaults to paxdraconia/nerdout-corpus and branch "master" if left blank.
CORPUS_GITHUB_REPO=
CORPUS_GITHUB_BRANCH=

# --- Phase 2 only (scheduling + email notifications) -----------------------
# Used by the GitHub Actions cron and the in-app re-auth flow. Safe to leave
# blank in Phase 1 — the immediate "Post Now" flow doesn't need them.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
NOTIFY_EMAIL=
SENDGRID_API_KEY=
